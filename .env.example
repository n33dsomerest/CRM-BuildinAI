# ──────────────────────────────────────────────────────────────────────────────
# CRM — environment variables template
# Copy to .env (local) or paste into Vercel → Project → Settings → Environment
# Variables.
# ──────────────────────────────────────────────────────────────────────────────

# DATABASE_URL — used by the app at runtime. On Neon, use the POOLED connection
# string (host contains "-pooler"). Vercel serverless requires connection pooling.
# Neon example:
#   postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-name-pooler.us-east-2.aws.neon.tech/crmglm?sslmode=require"

# DIRECT_URL — used by Prisma migrations (`prisma migrate deploy`).
# On Neon use the DIRECT (non-pooled) connection string:
#   postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME?sslmode=require
# On a plain Postgres instance it can be the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/crmglm?sslmode=require"

# AUTH_SECRET — secret for Auth.js session signing.
# Generate one: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
