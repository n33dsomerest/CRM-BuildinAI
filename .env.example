# CRM environment variables template
# Copy to .env (local) or paste into Vercel > Project > Settings > Environment Variables.
# Use plain ASCII only. Never commit the real .env file.

# DATABASE_URL - used by the app at runtime.
# On Neon, use the POOLED connection string (host contains "-pooler").
# Vercel serverless requires connection pooling.
DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# DIRECT_URL - used by Prisma migrations (prisma migrate deploy).
# On Neon use the DIRECT (non-pooled) connection string (no "-pooler" in host).
# On a plain Postgres instance it can be the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME?sslmode=require"

# AUTH_SECRET - secret for Auth.js session signing.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"

# Integration-test database (optional) - used by: npm run test:integration
# Tests truncate this database on every run, so it must be a throwaway,
# never your production or dev database. Create a second database in your
# Neon project (e.g. DBNAME_test) and fill in both:
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME_test?sslmode=require"
# DIRECT_URL_TEST="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME_test?sslmode=require"

# Set TEST_DB_DISPOSABLE=1 ONLY when the *_TEST database is genuinely ephemeral
# (e.g. a CI service container) and it is acceptable for it to be the same
# database as DATABASE_URL. Leave it unset locally so the guard stays active.
# TEST_DB_DISPOSABLE="1"

# AI (OpenRouter) - get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
AI_MODEL="anthropic/claude-sonnet-4.5"
AI_MODEL_CHEAP="google/gemini-2.5-flash"
