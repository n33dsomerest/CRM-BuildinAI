// Enterprise-grade CRM schema — PostgreSQL (Neon / Supabase compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
}

enum LeadStatus {
  NEW
  WORKING
  QUALIFIED
  UNQUALIFIED
}

enum LeadSource {
  WEB
  REFERRAL
  EVENT
  COLD_CALL
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
}

enum TaskStatus {
  OPEN
  DONE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SALES)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts   Account[]  @relation("AccountOwner")
  contacts   Contact[]  @relation("ContactOwner")
  leads      Lead[]     @relation("LeadOwner")
  deals      Deal[]     @relation("DealOwner")
  activities Activity[]
  tasks      Task[]     @relation("TaskAssignee")
  auditLogs  AuditLog[]

  @@index([role])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  ip          String
  attempts    Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([email, ip])
  @@index([windowStart])
}

model Account {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  ownerId   String
  owner     User     @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]

  @@index([name])
  @@index([ownerId])
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?
  position  String?
  status    ContactStatus @default(PROSPECT)
  accountId String
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@unique([accountId, email])
  @@index([status])
  @@index([name])
  @@index([ownerId])
  @@index([accountId])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  source    LeadSource @default(WEB)
  status    LeadStatus @default(NEW)
  ownerId   String
  owner     User       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([name])
}

model Stage {
  id          String  @id @default(cuid())
  name        String  @unique
  order       Int     @unique
  probability Int
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  deals Deal[]
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Decimal   @db.Decimal(12, 2)
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id])
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expectedCloseDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activities Activity[]
  tasks      Task[]

  @@index([stageId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
  @@index([createdAt])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  subject    String
  body       String?
  contactId  String
  contact    Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime     @default(now())

  @@index([contactId, occurredAt])
  @@index([dealId])
  @@index([userId])
}

model Task {
  id         String     @id @default(cuid())
  title      String
  dueDate    DateTime
  status     TaskStatus @default(OPEN)
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assigneeId String
  assignee   User       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([dueDate])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  feature      String // "summarize" | "draft" | "score" | "search" | "insight"
  ok           Boolean  @default(true)
  error        String? // error class only, never prompt or completion text
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  model        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AiCache {
  id        String   @id @default(cuid())
  key       String   @unique // sha256(feature + normalized input)
  feature   String
  response  String // validated JSON completion - served free, no quota cost
  createdAt DateTime @default(now())

  @@index([feature, createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  entity    String
  entityId  String
  action    AuditAction
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes   Json
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([userId])
}
